{
  "name": "nyma",
  "version": "0.7.0",
  "description": "Nyma Yokai Mystic Agent — a minimal coding agent built with Squint + Bun + Vercel AI SDK + pi-tui",
  "type": "module",
  "bin": {
    "nyma": "./dist/agent/cli.mjs",
    "nyma-gateway": "./dist/gateway/entry.mjs"
  },
  "scripts": {
    "dev": "concurrently \"npx squint watch\" \"bun --watch dist/agent/cli.mjs\"",
    "build": "npx squint compile",
    "bundle": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-darwin-arm64 --outfile=nyma",
    "bundle:all": "bun run bundle && bun run bundle:linux-x64 && bun run bundle:linux-arm64 && bun run bundle:linux-x64-musl && bun run bundle:linux-arm64-musl && bun run bundle:macos-x64 && bun run bundle:windows",
    "bundle:linux-x64": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-linux-x64 --outfile=nyma-linux-x64",
    "bundle:linux-arm64": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-linux-arm64 --outfile=nyma-linux-arm64",
    "bundle:macos-x64": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-darwin-x64 --outfile=nyma-macos-x64",
    "bundle:windows": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-windows-x64 --outfile=nyma-windows-x64.exe",
    "prestart": "npx squint compile",
    "start": "bun dist/agent/cli.mjs",
    "pretest": "npx squint compile",
    "test": "bun test dist",
    "repl": "npx squint repl",
    "gen:event-map": "npx squint compile && bun scripts/gen-event-map.mjs",
    "gen:builtins": "bun scripts/gen-builtin-extensions.mjs && npx squint compile",
    "bundle:linux-x64-musl": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-linux-x64-musl --outfile=nyma-linux-x64-musl",
    "bundle:linux-arm64-musl": "bun run build && bun build ./dist/agent/cli.mjs --compile --bytecode --format=esm --minify --target=bun-linux-arm64-musl --outfile=nyma-linux-arm64-musl"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.52",
    "@ai-sdk/google": "4.0.67",
    "@ai-sdk/openai": "4.0.65",
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@mariozechner/pi-tui": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "7.0.97",
    "headroom-ai": "^0.37.0",
    "linkedom": "^0.18.13",
    "marked": "^17.0.6",
    "marked-terminal": "^7.3.0",
    "shell-quote": "^1.10.0",
    "squint-cljs": "0.14.208",
    "turndown": "^7.2.4",
    "vscode-jsonrpc": "^9.0.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
