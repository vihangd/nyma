{
  "name": "nyma",
  "version": "0.13.0",
  "description": "Nyma Yokai Mystic Agent — a minimal coding agent built with Squint + Bun + Vercel AI SDK + pi-tui",
  "type": "module",
  "bin": {
    "nyma": "./dist/agent/cli.mjs",
    "nyma-gateway": "./dist/gateway/entry.mjs"
  },
  "scripts": {
    "dev": "concurrently \"npx squint watch\" \"bun --watch dist/agent/cli.mjs\"",
    "build": "bun scripts/gen-version.mjs && npx squint compile --paths src",
    "bundle": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-darwin-arm64 --outfile=nyma",
    "bundle:all": "bun run bundle && bun run bundle:linux-x64 && bun run bundle:linux-arm64 && bun run bundle:linux-x64-musl && bun run bundle:linux-arm64-musl && bun run bundle:macos-x64 && bun run bundle:windows",
    "bundle:linux-x64": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-linux-x64 --outfile=nyma-linux-x64",
    "bundle:linux-arm64": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-linux-arm64 --outfile=nyma-linux-arm64",
    "bundle:macos-x64": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-darwin-x64 --outfile=nyma-macos-x64",
    "bundle:windows": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-windows-x64 --outfile=nyma-windows-x64.exe",
    "prestart": "npx squint compile --paths src",
    "start": "bun dist/agent/cli.mjs",
    "pretest": "npx squint compile",
    "test": "bun test dist",
    "test:fast": "npx squint compile && bun test --parallel dist",
    "test:pilish": "bash scripts/test-pilish.sh",
    "eval:judge": "npx squint compile && bun scripts/eval-judge.mjs",
    "repl": "npx squint repl",
    "gen:bench-ledger": "bun scripts/gen-bench-ledger.mjs",
    "gen:event-map": "npx squint compile && bun scripts/gen-event-map.mjs",
    "gen:prices": "bun scripts/gen-prices.mjs",
    "gen:builtins": "bun scripts/gen-builtin-extensions.mjs && npx squint compile",
    "gen:namespaces": "bun scripts/gen-namespaces.mjs",
    "gen:events-doc": "npx squint compile && bun scripts/gen-events-doc.mjs",
    "bundle:linux-x64-musl": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-linux-x64-musl --outfile=nyma-linux-x64-musl",
    "bundle:linux-arm64-musl": "bun run build && bun build ./dist/agent/cli.mjs ./dist/agent/extensions/codemode/worker.mjs --compile --compile-autoload-package-json --compile-exec-argv=--no-orphans --bytecode --format=esm --minify --target=bun-linux-arm64-musl --outfile=nyma-linux-arm64-musl",
    "gen:version": "bun scripts/gen-version.mjs",
    "hooks:install": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-tui": "1.0.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "ai": "7.0.127",
    "headroom-ai": "0.39.1",
    "linkedom": "^0.18.13",
    "marked": "^18.0.0",
    "shell-quote": "1.12.0",
    "squint-cljs": "0.14.211",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "vscode-jsonrpc": "9.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
